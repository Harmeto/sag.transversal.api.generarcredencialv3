; Este proyecto no usa paquetes npm. El archivo existe porque la tarea
; npmAuthenticate@0 del pipeline estándar del SAG lo requiere; las credenciales
; las inyecta Azure DevOps en tiempo de ejecución, por eso aquí no hay ninguna.
registry=https://registry.npmjs.org
@sag:registry=https://pkgs.dev.azure.com/SubdepartamentoSolucionesTI/_packaging/SubdepartamentoSolucionesTI/npm/registry/
always-auth=true
