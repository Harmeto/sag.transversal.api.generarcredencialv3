# Entorno local (sin Consul). En OpenShift estas variables vendrían de Consul/ConfigMap.
APP_NAME=sag.transversal.api.generarcredencialV3
HOST=0.0.0.0
PORT=3345
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/generador_credenciales_v3

# Render (Typst)
PLANTILLAS_DIR=./plantillas
FONTS_DIR=./fonts
# Renders simultáneos máximos (default: núcleos disponibles)
# RENDER_CONCURRENCY=8

# Storage de documentos. Adaptador local: escribe en STORAGE_DIR y publica en STORAGE_PUBLIC_URL.
# En producción se reemplaza por el adaptador de Azure Blob (pendiente, ver README).
STORAGE_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3345/archivos
