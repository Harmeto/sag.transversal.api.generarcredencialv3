# ---------------------------------------------------------------------------
# Desarrollo local (NODE_ENV=local): la configuración sale de este archivo.
# En dev/test/qa/prod NO se usa .env: el ConfigMap del release entrega NODE_ENV,
# APP_NAME y CONSUL_*, y el resto se lee desde Consul. Ver docs/CONSUL.md.
# ---------------------------------------------------------------------------
NODE_ENV=local
APP_NAME=sag.transversal.api.generarcredencialv3
HOST=0.0.0.0
APP_PORT=3345
LOG_LEVEL=info

# PostgreSQL (sólo en local; en los ambientes viene de Consul)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/generador_credenciales_v3

# Render (Typst)
PLANTILLAS_DIR=./plantillas
FONTS_DIR=./fonts
# Renders simultáneos máximos (default: núcleos disponibles)
# RENDER_CONCURRENCY=8

# Storage de documentos: "local" (disco + /archivos) o "azure" (Azure Blob).
# En los ambientes lo decide Consul: si la config trae blobStorageConfigValue, se usa Azure.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3345/archivos
# STORAGE_DRIVER=azure
# BLOB_STORAGE_CONNECTION_STRING=
# BLOB_STORAGE_ACCOUNT_NAME=

# ---------------------------------------------------------------------------
# Sólo para probar en local el arranque "como en un ambiente" contra un Consul
# propio (ver docs/CONSUL.md, sección de verificación local):
# NODE_ENV=dev
# CONSUL_HOST=localhost
# CONSUL_PORT=8500
# CONSUL_SECURE=false
# CONSUL_REJECT_UNAUTHORIZED=false
# CONSUL_ACL_TOKEN=
